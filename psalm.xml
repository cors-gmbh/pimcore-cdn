<?xml version="1.0"?>
<!-- Public repository: cors/dev (private Packagist) is not reachable from GitHub Actions here,
     so the shared issue handlers come from the public coreshop/test-setup package. -->
<!-- The shared UndefinedConstant suppression targets Pimcore constants this bundle never uses. -->
<psalm xmlns:xi="http://www.w3.org/2001/XInclude" findUnusedIssueHandlerSuppression="false">
    <xi:include
            href="vendor/coreshop/test-setup/psalm.xml"
            xpointer="xpointer(/psalm/*[not(self::projectFiles)])"
    />
    <projectFiles>
        <directory name="src" />
        <ignoreFiles>
            <directory name="vendor" />
        </ignoreFiles>
    </projectFiles>
    <issueHandlers>
        <!-- Pimcore marks ThumbnailTransform/CropRegion/AssetWebPath @internal although ImageTransformAdapterInterface hands them to us. -->
        <InternalMethod><errorLevel type="suppress"><directory name="src/Provider" /><directory name="src/Purge" /></errorLevel></InternalMethod>
        <InternalProperty><errorLevel type="suppress"><directory name="src/Provider" /></errorLevel></InternalProperty>
        <!-- Symfony config-tree builder chains always end in an unused ->end(). -->
        <UnusedMethodCall><errorLevel type="suppress"><file name="src/DependencyInjection/Configuration.php" /></errorLevel></UnusedMethodCall>
        <UnusedClass errorLevel="info" />
        <PossiblyUnusedMethod errorLevel="info" />
        <PossiblyUnusedParam errorLevel="info" />
        <MissingConstructor errorLevel="info" />
    </issueHandlers>
</psalm>