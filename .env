###> docker ###
DOCKER_PROJECT_NAME=cors-pimcore-cdn
DOCKER_ALPINE_VERSION=3.22
DOCKER_PHP_VERSION=8.4
DOCKER_BASE_IMAGE=8.0-latest
###< docker ###

APP_ENV=dev
APP_DEBUG=1
PIMCORE_KERNEL_CLASS=\Kernel

###> pimcore/pimcore ###
# Defaults match the dev-compose services; override in .env.local.
DATABASE_URL="mysql://pimcore:pimcore@db:3306/pimcore?serverVersion=8.0.26"
PIMCORE_MESSENGER_TRANSPORT_DSN_PREFIX="doctrine://default?queue_name="
###< pimcore/pimcore ###

###> pimcore/opensearch-client ###
PIMCORE_OPENSEARCH_DSN="opensearch://opensearch:9200?ssl=false"
###< pimcore/opensearch-client ###

###> pimcore/studio-backend-bundle ###
# nginx proxies /hub to the mercure container; the key must match the hub's
# MERCURE_PUBLISHER_JWT_KEY / MERCURE_SUBSCRIBER_JWT_KEY (set by dev-compose).
MERCURE_JWT_KEY="SECRET_MERCURE_KEY_SECRET_MERCURE_KEY"
MERCURE_URL="https://cors-pimcore-cdn.dev.localhost/hub"
MERCURE_SERVER_URL="http://mercure/.well-known/mercure"
###< pimcore/studio-backend-bundle ###

###> pimcore/pimcore CDN ###
# Selects the purge client (empty = CDN integration off). See README for provider values.
CDN_PROVIDER=
CDN_IMAGE_OPTIMIZER=
CDN_BASE_URL=
###< pimcore/pimcore CDN ###

###> cors/pimcore-cdn ###
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CDN_URL_MAP=
AWS_CLOUDFRONT_DISTRIBUTION_ID=
AZURE_FRONTDOOR_RESOURCE_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
###< cors/pimcore-cdn ###
